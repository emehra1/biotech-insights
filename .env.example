# Everything here is OPTIONAL for local use: the pipeline, the site and the
# email preview all run with no configuration at all. These are only needed to
# actually SEND mail, which requires an explicit `--send` flag anyway.
#
# In CI these live as GitHub repository secrets, not in a file.

SMTP_HOST=smtp.gmail.com
# 465 (implicit TLS) or 587 (STARTTLS). Port 25 is blocked on GitHub runners.
SMTP_PORT=465
SMTP_USER=you@gmail.com
# Gmail requires an App Password (Google Account → Security → 2-Step
# Verification → App passwords). Your normal login password will not work, and
# "less secure app access" no longer exists.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# For Gmail this must be the same address as SMTP_USER, or Gmail rewrites the
# From header and DMARC alignment suffers.
MAIL_FROM="Biotech Insights <you@gmail.com>"
MAIL_TO=you@gmail.com

# Used for the "view on the web" link in the email.
SITE_URL=http://localhost:3000

# Optional: extra watchlist entries in the same YAML shape as
# config/watchlist.yml. Use this for terms you do NOT want published — the
# GitHub Pages site is publicly readable even from a private repo, but this
# value only ever affects the email.
# WATCHLIST_PRIVATE="entries:\n  - id: secret\n    kind: company\n    match:\n      any: [Acme Bio]"
