{
  "name": "biotech-insights",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "npm run data && next dev",
    "data": "tsx pipeline/emit/build-site-data.ts",
    "prebuild": "tsx pipeline/emit/build-site-data.ts",
    "build": "next build",
    "start": "next start",
    "pipeline": "tsx pipeline/run.ts",
    "weekly": "tsx pipeline/rollup/run-weekly.ts",
    "email": "node --env-file-if-exists=.env --import tsx scripts/send-email.ts",
    "validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "js-yaml": "^4.1.0",
    "next": "^14.2.5",
    "nodemailer": "^6.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.5",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
